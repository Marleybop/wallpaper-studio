<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- steam_api64.dll is 64-bit only -->
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Version>2.0.0</Version>
    <Product>Wallpaper Studio Uploader</Product>
    <!-- the UI is built in code, not the designer, so designer serialization checks don't apply -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <!-- `dotnet publish -c Release` makes a folder that runs without installing .NET -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- keep this PC's folder paths out of the released exe -->
    <PathMap>$(MSBuildProjectDirectory)=/src</PathMap>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Facepunch.Steamworks" Version="2.3.3" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- Marleybop brand fonts (SIL Open Font Licence; licences in Fonts\) -->
    <EmbeddedResource Include="Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <!-- the package ships Valve's native library as legacy "content", which SDK projects don't copy -->
    <None Include="$(PkgFacepunch_Steamworks)\content\steam_api64.dll" Link="steam_api64.dll" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" Visible="false" />
  </ItemGroup>

</Project>
